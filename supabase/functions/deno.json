{
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "esnext"],
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false
  },
  "tasks": {
    "check": "deno check */index.ts",
    "lint": "deno lint",
    "fmt-check": "deno fmt --check"
  }
}
