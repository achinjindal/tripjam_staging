# Copy to .env and fill in. Values are per-environment: local dev and E2E
# point at the STAGING Supabase project; .env.production points at prod.
#
# Generated from the VITE_* vars actually referenced in src/.

VITE_APP_ENV=

VITE_BOOKING_AID=

# set to 1 by playwright.config to suppress paid background calls
VITE_E2E_CHEAP=

# MUST equal the backend INBOUND_EMAIL_ADDRESS secret (CLAUDE.md pairing rule). Without it the forward-booking UI silently does not render
VITE_EMAIL_INGEST_ADDRESS=

VITE_FLIGHT_LINK_PREFIX=

VITE_HOTEL_LINK_PREFIX=

# gates collaboration invite UI (default off)
VITE_INVITE_ENABLED=

VITE_MAPBOX_TOKEN=

VITE_PLACE_PEEK_ENABLED=

VITE_POSTHOG_HOST=

VITE_POSTHOG_KEY=

# gates the realtime scaffold (default off)
VITE_REALTIME_ENABLED=

VITE_REVENUECAT_ANDROID_KEY=

VITE_ROUTES_LENS_ENABLED=

# Supabase anon key — public, ships in the bundle
VITE_SUPABASE_ANON_KEY=

# Supabase project URL (staging for local dev)
VITE_SUPABASE_URL=
